#!/usr/bin/env bash
# solaris-fetch — SEU CXXY RoboMaster · SOLARIS 战队终端横幅（独立程序，与 neofetch 无关）
# 布局：ROBOMASTER 艺体字 / 天钺(横排) / 校徽 + 大号 SOLARIS 并排 / 右侧信息栏
# 字形数据全部用 ASCII 编码：# = █，A = ▀，D = ▄，. = 空格（运行期展开，避免半块字符维护陷阱）
# 用法: solaris-fetch [ -a | --animate ]
set -u

RST=$'\033[0m' BOLD=$'\033[1m' DIM=$'\033[2m'
tc(){ printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"; }
# ASCII 编码 → 块字符（#→█ A→▀ D→▄ .→空格）
ex(){ local s=$1 o="" i c
  for ((i=0;i<${#s};i++)); do c=${s:i:1}
    case $c in
      '#') o+=$'\u2588' ;;
      A)   o+=$'\u2580' ;;
      D)   o+=$'\u2584' ;;
      *)   o+=' ' ;;
    esac
  done
  printf '%s' "$o"
}
# 重复字符串：rr <字符> <次数>
rr(){ local c=$1 n=$2 o="" i; for ((i=0;i<n;i++)); do o+=$c; done; printf '%s' "$o"; }

W=72   # 图标栏可视宽度

# ── SOLARIS 大号块字（6x7，稍后拼在校徽右侧）──
g_S=(".####." "##...." "##...." ".###.." "....##" "....##" "###...")
g_O=(".####." "##..##" "##..##" "##..##" "##..##" "##..##" ".####.")
g_L=("##...." "##...." "##...." "##...." "##...." "##...." "######")
g_A=(".####." "##..##" "##..##" "######" "##..##" "##..##" "##..##")
g_R=("#####." "##..##" "##..##" "#####." "##.#.." "##..#." "##...#")
g_I=("######" "..##.." "..##.." "..##.." "..##.." "..##.." "######")
wcol=()
for n in 0 1 2 3 4 5 6; do
  raw="${g_S[n]} ${g_O[n]} ${g_L[n]} ${g_A[n]} ${g_R[n]} ${g_I[n]} ${g_S[n]}"
  line=""; len=${#raw}
  for ((x=0; x<len; x++)); do
    c=${raw:x:1}
    if [[ $c == "#" ]]; then
      # 水平渐变：琥珀金 → 太阳红
      g=$((205 - 150 * x / (len-1)))
      b=$((40 - 15 * x / (len-1)))
      line+="$(tc 255 "$g" "$b")$(ex "#")${RST}"
    else
      line+=" "
    fi
  done
  wcol+=("$line")
done

# ── 顶部 ROBOMASTER 艺体字：3 行半块，双色金属 ──
rR=("#A#" "##A" "#.#"); rO=("#A#" "#.#" "AAA"); rB=("#AD" "#AD" "AAA")
rM=("#DAD#" "#.#.#" "#...#"); rA=("#A#" "###" "#.#"); rS=("#AA" "AA#" "AAA")
rT=("A#A" ".#." ".#."); rE=("#AA" "##." "AAA")
rmc=()
for n in 0 1 2; do
  body="${rR[n]} ${rO[n]} ${rB[n]} ${rO[n]} ${rM[n]} ${rA[n]} ${rS[n]} ${rT[n]} ${rE[n]} ${rR[n]}"
  bl=${#body}; ld=$(( (W - bl) / 2 )); rd=$(( W - bl - ld ))
  L=""
  for ((p=0; p<ld; p++)); do L+="${DIM}$(tc 110 120 138)$(rr '─' 1)${RST}"; done
  for ((x=0; x<bl; x++)); do
    c=${body:x:1}
    case $c in
      A|D) L+="$(tc 235 240 250)$(ex "$c")${RST}" ;;
      '#') L+="$(tc 150 162 185)$(ex "$c")${RST}" ;;
      *)   L+=" " ;;
    esac
  done
  for ((p=0; p<rd; p++)); do L+="${DIM}$(tc 110 120 138)$(rr '─' 1)${RST}"; done
  rmc+=("$L")
done

# ── 天钺 横排（微软雅黑Bold 点阵，12 行 × 41 宽，太阳纵向渐变）──
ty_src=(".##################....##D........##.DD.."
        ".AAAAAAA####AAAAAAA....###DD......##.A#A."
        "........D##...........#####A.############"
        "........###..........D##D....##AAA##AAAAA"
        "D##################D.A######.##...##..D.."
        "####################..AA##...##...##.D##."
        ".......#####D........D######.##...##D##.."
        "......D##AA##D.......AA###AA.##.DD####A.."
        "....D###A..###D.........##...####AD##A.#D"
        "..D####A....A###DD.....D#######A.D###..##"
        ".####A.......A#####A...####A.A.D###A####."
        ".A#A...........AA#......A.......#A..A##A.")
thw=${#ty_src[0]}
tyl=()
for ((i=0; i<12; i++)); do
  g=$((215 - 160 * i / 11)); b=$((55 - 30 * i / 11))
  row=${ty_src[i]}
  line=""
  for ((x=0; x<thw; x++)); do
    c=${row:x:1}
    if [[ $c == "." ]]; then line+=" "; else line+="$(tc 255 "$g" "$b")$(ex "$c")${RST}"; fi
  done
  pad=$(( (W - thw) / 2 ))
  tyl+=("$(printf "%${pad}s" '')${line}$(printf "%$(( W - pad - thw ))s" '')")
done

# ── 校徽（黄环+绿三角+大礼堂）＋ 右侧大号 SOLARIS 并排 ──
yE="$(tc 250 200 40)"; gE="$(tc 96 168 84)"; wE="$(tc 232 226 216)"
H4=$(rr '─' 4); T8=$(rr '▔' 8); D6=$(rr '▄' 6); K4=$(rr '█' 4); A2=$(rr '▀' 2)
e=()
e+=("  ${yE}╭${H4} 東南大學 ${H4}╮${RST}")
e+=("  ${yE}│${RST}     ${gE}${T8}${RST}     ${yE}│${RST}")
e+=("  ${yE}│${RST}    ${gE}╲${RST} ${yE}${D6}${RST} ${gE}╱${RST}    ${yE}│${RST}")
e+=("  ${yE}│${RST} ${wE}1902${RST} ${yE}▟${K4}▙${RST} ${wE}南京${RST} ${yE}│${RST}")
e+=("  ${yE}│${RST}       ${gE}╲${A2}╱${RST}       ${yE}│${RST}")
e+=("  ${yE}╰${H4} 止於至善 ${H4}╯${RST}")

colored=()
colored+=("${rmc[@]}")
colored+=("${tyl[@]}")
for ((n=0; n<7; n++)); do
  if (( n < 6 )); then
    colored+=("${e[n]} ${wcol[n]} ")
  else
    colored+=("$(printf '%23s' '')${wcol[n]} ")
  fi
done

# ── 系统信息（取不到就优雅降级，不会报错）──
user="${USER:-$(id -un 2>/dev/null || echo user)}"
host="$(hostname 2>/dev/null | cut -c1-20 || true)"; host="${host:-seu-cxxy}"
os="Linux"
[[ -r /etc/os-release ]] && os="$(. /etc/os-release && echo "${PRETTY_NAME:-$NAME $VERSION}")"
kernel="$(uname -r 2>/dev/null || echo '?')"
uptime="?"; [[ -r /proc/uptime ]] && uptime="$(awk '{s=$1+0; d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60); o=""; if(d)o=o d"d "; if(h||d)o=o h"h "; print o m"m"}' /proc/uptime)"
shell="$(basename "${SHELL:-bash}")"
cpu="$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null)"
[[ -z $cpu ]] && cpu="$(uname -m)"
cpu="$(printf '%s' "$cpu" | sed -E 's/\([RrTtMmCcEe]+\)//g; s/@.*//; s/[[:space:]]+/ /g; s/[[:space:]]+$//' | cut -c1-34)"
mem="? / ?"
[[ -r /proc/meminfo ]] && mem="$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t)printf "%d / %d MiB",(t-a)/1024,t/1024}' /proc/meminfo)"
gpu="$(lspci 2>/dev/null | awk -F': ' '/VGA|3D|Display/{print $NF; exit}' | sed -E 's/^.*: //; s/\[.*//; s/[[:space:]]+$//' | cut -c1-34)"
ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

# ── 右侧面板 ──
oY="$(tc 255 184 60)"; oR="$(tc 255 82 45)"; wt="$(tc 232 226 216)"; gy="$(tc 148 140 130)"
lab(){ printf '%s%-7s%s%s' "$oR" "$1" "$wt" "$2"; }
right=()
right+=("${BOLD}${oY}SEU CXXY ${wt}· ${oR}ROBOMASTER${RST}")
right+=("${oR}╭${oY}────────────────────────────${oR}╮${RST}")
right+=("${oR}│${BOLD}${wt}   S O L A R I S  T E A M   ${oR}│${RST}")
right+=("${oR}╰${oY}────────────────────────────${oR}╯${RST}")
right+=("$(lab host   "${user}@${host}")")
right+=("$(lab os     "${os}")")
right+=("$(lab kernel "${kernel}")")
right+=("$(lab uptime "${uptime}")")
right+=("$(lab shell  "${shell}")")
right+=("$(lab cpu    "${cpu}")")
[[ -n $gpu ]] && right+=("$(lab gpu    "${gpu}")")
[[ -n $ip  ]] && right+=("$(lab ip     "${ip}")")
right+=("$(lab mem    "${mem}")")
right+=("$(lab school "东南大学成贤学院 (SEU CXXY)")")
right+=("$(lab team   "天钺 (Solaris)")")
right+=("$(lab slogan "秣陵形胜，共赴千山")")
right+=("${DIM}${gy}────────────────────────────${RST}")
right+=("${oY}▸ SYS.ACTIVE ${oR}● ${wt}SOLARIS-2026 ${oR}● ${wt}TEAM-01${RST}")

# ── 合成：左图标 + 右信息 ──
out=()
R=${#right[@]}
LN=${#colored[@]}
for ((n=0; n<LN || n<R; n++)); do
  L="${colored[n]:-}"
  [[ -z ${colored[n]:-} ]] && L="$(printf '%*s' "$W" '')"
  out+=("${L}   ${right[n]:-}")
done

# ── 底部：渐变能量条 + 战队口号 ──
bar=""
for ((x=0; x<W+40; x++)); do
  t=$((150 * x / (W+39))); g=$((205 - t)); b=$((40 - 15 * x / (W+39)))
  bar+="$(tc 255 "$g" "$b")$(rr '▇' 1)"
done
out+=("${bar}${RST}")
out+=("${DIM}${RST}")
out+=("  ${BOLD}${oY}秣陵形胜，共赴千山${RST}")
out+=("  ${DIM}$(tc 200 120 60)BEYOND LIMITS · DEFEND OUR HONOR · UNITED WE BUILD VICTORY${RST}")

case "${1:-}" in
  -a|--animate)
    for l in "${out[@]}"; do printf '%s\n' "$l"; sleep 0.05; done
    ;;
  *)
    printf '%s\n' "${out[@]}"
    ;;
esac
