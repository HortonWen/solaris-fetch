#!/usr/bin/env bash
# astro-fetch — 东南大学成贤学院天文爱好者协会 终端横幅（独立程序）
# 左侧：协会英文名艺体字 + 徽章像素画（星空环/花瓣框/占星少女）；右侧：协会 + 系统信息
# 用法:
#   astro-fetch            直接显示
#   astro-fetch -a         逐行动画显示
set -u

RST=$'\033[0m' BOLD=$'\033[1m' DIM=$'\033[2m'
tc(){ printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"; }
W=48

# ── 顶部协会英文名艺体字：3 行半块字形，暮紫渐变 ──
gA=("█▀█" "███" "█ █"); gS=("█▀▀" "▀▀█" "▀▀"); gT=("▀█▀" " █ " " █ ")
gR=("█▀█" "██▀" "█ █"); gO=("█▀█" "█ █" "▀▀▀"); gN=("█▄▀█" "█  █" "█  █")
gM=("█▄▀▄█" "█ ▀ █" "█   █"); gY=("█ █" "▀█▀" " █ "); gC=("█▀▀" "█  " "█▀▀")
gI=("█" "█" "█")
words=("ASTRONOMY" "ASSOCIATION")
name_rows=()
for w in "${words[@]}"; do
  for n in 0 1 2; do
    body=""
    for ((i=0; i<${#w}; i++)); do
      ch=${w:i:1}
      case $ch in
        A) g=("${gA[@]}");; S) g=("${gS[@]}");; T) g=("${gT[@]}");; R) g=("${gR[@]}");;
        O) g=("${gO[@]}");; N) g=("${gN[@]}");; M) g=("${gM[@]}");; Y) g=("${gY[@]}");;
        C) g=("${gC[@]}");; I) g=("${gI[@]}");;
      esac
      [[ -n $body ]] && body+=" "
      body+="${g[n]}"
    done
    name_rows+=("$body")
  done
done
colored=()
for ((n=0; n<6; n++)); do
  body=${name_rows[n]}
  bl=${#body}; ld=$(( (W - bl) / 2 )); rd=$(( W - bl - ld ))
  L=""
  for ((p=0; p<ld; p++)); do L+="${DIM}$(tc 80 80 160)─${RST}"; done
  for ((x=0; x<bl; x++)); do
    c=${body:x:1}
    if [[ $c == " " ]]; then L+=" "; else
      r=$((90 + 100 * x / (bl-1))); g=$((120 - 20 * x / (bl-1)))
      L+="$(tc "$r" "$g" 255)$c${RST}"
    fi
  done
  for ((p=0; p<rd; p++)); do L+="${DIM}$(tc 80 80 160)─${RST}"; done
  colored+=("$L")
done

# ── 徽章像素画：星空渐变圆环 + 白花瓣框 + 占星少女 ──
badge=(
  ".............RRRRRRRRRR............."
  "..........RRRRRRRRRRRRRRRR.........."
  "........RRRRRRRRRRRRRRRRRRRR........"
  ".......RRRWRRRRRRRRRRRRWRRRRR......."
  "......RRRRRRFFFFFFFFFFFFRRRRRR......"
  ".....RRRRRRFFFFFFFFFFFFFFRRRRRR....."
  ".....RRWRRFFIIKKKKKKKKIIFFRRWRR....."
  "....RRRRRFFHHKKKKKKKKKKHHFFRRRRR...."
  "....RRRRFHHHKKKKKsKKKKGGHHHFRRRR...."
  "....RWRFFHHHHHHHHsHHHHHHHHHFFRWR...."
  "....RRRRFSSTTSSSSSSGPPGSSSSFRRRR...."
  "....RRRRRFFSBBSSmmSSBBSGSFFRRRRR...."
  ".....RRWRRFFHHHSSSSSSHHHFFRRWRR....."
  ".....RRRRRRFFFFFFFFFFFFFFRRRRRR....."
  "......RRRRRRFFFFFFFFFFFFRRRRRR......"
  "........RRRRRRRRRRRRRRRRRRRR........"
  "..........RRRRRRRRRRRRRRRR.........."
  "............RRRRRWWRRRRR............"
)
for ((r=0; r<${#badge[@]}; r++)); do
  row=${badge[r]}
  L=""
  for ((x=0; x<${#row}; x++)); do
    c=${row:x:1}
    case $c in
      R) # 星空环：左上蓝 → 右下紫，确定伪随机星点
         if (( (x*7 + r*13) % 29 == 0 )); then L+="$(tc 235 243 255)█${RST}"
         else
           t=$(( (x*60/35 + r*40/17) ))
           L+="$(tc $((125 + 40*t/100)) $((185 - 45*t/100)) $((238 - 13*t/100)))█${RST}"
         fi ;;
      W) L+="$(tc 255 255 255)█${RST}" ;;
      F) L+="$(tc 250 250 246)█${RST}" ;;
      I) L+="$(tc 252 252 248)█${RST}" ;;
      K) L+="$(tc 95 100 130)█${RST}" ;;
      H) L+="$(tc 228 242 250)█${RST}" ;;
      s) L+="$(tc 150 215 235)█${RST}" ;;
      G) L+="$(tc 205 165 70)█${RST}" ;;
      S) L+="$(tc 255 236 228)█${RST}" ;;
      B) L+="$(tc 250 175 175)█${RST}" ;;
      T) L+="$(tc 95 190 205)█${RST}" ;;
      P) L+="$(tc 150 120 205)█${RST}" ;;
      m) L+="$(tc 230 140 150)█${RST}" ;;
      *) L+=" " ;;
    esac
  done
  colored+=("$(printf '%6s' '')${L}$(printf '%6s' '')")   # 36 宽居中到 48
done

# ── 系统信息 ──
user="${USER:-$(id -un 2>/dev/null || echo user)}"
host="$(hostname 2>/dev/null | cut -c1-20 || true)"; host="${host:-seu-cxxy}"
os="Linux"
[[ -r /etc/os-release ]] && os="$(. /etc/os-release && echo "${PRETTY_NAME:-$NAME $VERSION}")"
kernel="$(uname -r 2>/dev/null || echo '?')"
uptime="?"; [[ -r /proc/uptime ]] && uptime="$(awk '{s=$1+0; d=int(s/86400); h=int(s%86400/3600); m=int(s%3600/60); o=""; if(d)o=o d"d "; if(h||d)o=o h"h "; print o m"m"}' /proc/uptime)"
shell="$(basename "${SHELL:-bash}")"
cpu="$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null)"
[[ -z $cpu ]] && cpu="$(uname -m)"
cpu="$(printf '%s' "$cpu" | sed -E 's/\([RrTtMmCcEe]+\)//g; s/@.*//; s/[[:space:]]+/ /g; s/[[:space:]]+$//' | cut -c1-34)"
mem="? / ?"
[[ -r /proc/meminfo ]] && mem="$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{if(t)printf "%d / %d MiB",(t-a)/1024,t/1024}' /proc/meminfo)"
gpu="$(lspci 2>/dev/null | awk -F': ' '/VGA|3D|Display/{print $NF; exit}' | sed -E 's/^.*: //; s/\[.*//; s/[[:space:]]+$//' | cut -c1-34)"
ip="$(hostname -I 2>/dev/null | awk '{print $1}')"

# ── 右侧面板（星夜紫蓝主题）──
vY="$(tc 170 160 255)"; vB="$(tc 120 140 255)"; wt="$(tc 232 226 216)"; gy="$(tc 148 140 130)"
lab(){ printf '%s%-7s%s%s' "$vY" "$1" "$wt" "$2"; }
right=()
right+=("${BOLD}${vY}SEU CXXY ${wt}· ${vB}ASTRONOMY ASSOCIATION${RST}")
right+=("${vB}╭${vY}────────────────────────────${vB}╮${RST}")
right+=("${vB}│${BOLD}${wt}  ASTRONOMY ASSOCIATION  ${vB}│${RST}")
right+=("${vB}╰${vY}────────────────────────────${vB}╯${RST}")
right+=("$(lab host   "${user}@${host}")")
right+=("$(lab os     "${os}")")
right+=("$(lab kernel "${kernel}")")
right+=("$(lab uptime "${uptime}")")
right+=("$(lab shell  "${shell}")")
right+=("$(lab cpu    "${cpu}")")
[[ -n $gpu ]] && right+=("$(lab gpu    "${gpu}")")
[[ -n $ip  ]] && right+=("$(lab ip     "${ip}")")
right+=("$(lab mem    "${mem}")")
right+=("$(lab school "东南大学成贤学院 (SEU CXXY)")")
right+=("${DIM}${gy}────────────────────────────${RST}")
right+=("${vY}▸ CLEAR SKY ${vB}● ${wt}ASTRO-2026 ${vB}● ${wt}AD ASTRA${RST}")

# ── 合成 ──
out=()
R=${#right[@]}
LN=${#colored[@]}
for ((n=0; n<LN || n<R; n++)); do
  L="${colored[n]:-}"
  [[ -z ${colored[n]:-} ]] && L="$(printf '%*s' "$W" '')"
  out+=("${L}   ${right[n]:-}")
done

# ── 底部蓝紫能量条 ──
bar=""
for ((x=0; x<W+40; x++)); do
  r=$((90 + 100 * x / (W+39))); g=$((120 - 20 * x / (W+39)))
  bar+="$(tc "$r" "$g" 255)▇"
done
out+=("${bar}${RST}")

case "${1:-}" in
  -a|--animate)
    for l in "${out[@]}"; do printf '%s\n' "$l"; sleep 0.05; done
    ;;
  *)
    printf '%s\n' "${out[@]}"
    ;;
esac
